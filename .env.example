# Copy to apps/web/.env.local and fill in. Never commit real values.

# Supabase. The browser key is the anon key (docs/DECISIONS.md, 2026-10-29).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server only, never in client code

# Public site: the deployed origin (robots.txt, sitemap.xml) and the inbox /support and /delete-account show.
# Local and preview builds fall back to localhost and support@example.com; a Vercel production build fails
# when either is unset or the support address is an example.com one (apps/web/src/lib/production-env.ts).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Models: callModel(task, input) reads these, so switching is config, not code
MODEL_PROVIDER=
MODEL_EXTRACT=
MODEL_EXTRACT_BACKUP=
MODEL_GRADE=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron sends this as a bearer token
CRON_SECRET=

# Play Stats API (docs/PLAY_API.md): openssl rand -hex 32, same value in the stats dashboard
DASHBOARD_API_KEY=
PLAY_SLUG=session-coach
