{
  "name": "session-coach",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:rls": "pnpm --filter web test:rls",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:local": "node scripts/use-local-db.mjs",
    "db:live": "node scripts/use-local-db.mjs --off",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "check:commits": "node scripts/check-commit-message.mjs --range origin/main..HEAD",
    "seed:demo": "node --env-file=apps/web/.env.local scripts/seed-demo.mjs --dry-run",
    "seed:demo:live": "node --env-file=apps/web/.env.local scripts/seed-demo.mjs",
    "seed:demo:local": "node --env-file=apps/web/.env.development.local scripts/seed-demo.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0"
  }
}
