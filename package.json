{
  "name": "session-coach",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "check:commits": "node scripts/check-commit-message.mjs --range origin/main..HEAD",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0"
  }
}
