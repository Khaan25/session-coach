{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "jsdoc",
    "react",
    "react-perf",
    "nextjs",
    "jsx-a11y"
  ],
  "jsPlugins": ["@shadcn/lint"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "src/lib/supabase/database.types.ts"
  ],
  "rules": {
    // Configured
    "react/jsx-filename-extension": ["error", { "extensions": [".tsx"] }],
    "no-console": ["error", { "allow": ["error", "warn"] }],
    "react/no-unknown-property": ["error", { "ignore": ["skullet-own"] }], // skullet's skeleton marker attribute
    "new-cap": ["error", { "capIsNewExceptionPattern": "^[A-Z][A-Za-z]*_[A-Z]" }], // next/font loaders are called without new: Mona_Sans(), Geist_Mono()
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      { "roles": ["tabpanel", "region", "application"] }
    ], // scrollable regions and the canvas widget must be keyboard-reachable
    "react/only-export-components": [
      "error",
      {
        "allowExportNames": [
          "metadata",
          "generateMetadata",
          "viewport",
          "generateViewport",
          "generateStaticParams",
          "dynamic",
          "revalidate",
          "runtime",
          "instant",
          "dynamicParams",
          "fetchCache",
          "preferredRegion",
          "maxDuration",
          "alt",
          "size",
          "contentType"
        ]
      }
    ],

    // Off: contradicts the framework or a repo convention
    "react/react-in-jsx-scope": "off", // React 17+ JSX transform; React is never in scope
    "react/no-multi-comp": "off", // compound components share a file (docs/rules/components.md)
    "react/forbid-component-props": "off", // className on components is policed by shadcn/no-restyle instead
    "react/jsx-props-no-spreading": "off", // wrappers forward props to the primitive they wrap, and copy tables spread into notices (docs/rules/components.md)

    // Off: arbitrary size threshold
    "react/jsx-max-depth": "off",

    // Off: bans a language feature the code uses by design
    "react/jsx-no-literals": "off", // the UI is English-only with no i18n layer; copy lives in JSX

    // Off: false positives here
    "jsx-a11y/prefer-tag-over-role": "off", // wants <output>, <fieldset>, <img> or <li> for roles on components and live regions, where the native tag changes styling or behaviour
    "react/incompatible-library": "off", // React Compiler notice about libraries such as useVirtualizer; the app doesn't run the compiler
    "react/todo": "off", // React Compiler bail-out notices ("can't lower X yet"), not defects; the app doesn't run the compiler
    "react-perf/jsx-no-jsx-as-prop": "off", // flags every slot prop (docs/rules/components.md rung 3) and DOM handler; no React Compiler, no measured render cost
    "react-perf/jsx-no-new-function-as-prop": "off", // same
    "react-perf/jsx-no-new-object-as-prop": "off", // same
    "react-perf/jsx-no-new-array-as-prop": "off" // same
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
        "shadcn/no-raw-colors": "error",
        "shadcn/no-arbitrary-values": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": "error",
        "shadcn/require-static-classes": "error"
      }
    },
    {
      "files": ["src/components/ui/**/*.tsx"],
      "rules": {
        "typescript/no-deprecated": "off", // these files define the deprecated aliases, and each definition trips the rule
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "react/no-array-index-key": "off", // tokens, chart points and table cells are positional lists with no id
        "import/no-namespace": "off", // shadcn source imports `* as React`
        "react/only-export-components": "off" // shadcn files export cva `*Variants` next to their components
      }
    },
    {
      // Next.js file conventions, config files and React Email templates must default-export
      "files": [
        "src/app/**/{page,layout,template,default,loading,error,global-error,not-found,forbidden,unauthorized,sitemap,robots,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}",
        "src/emails/**/*.tsx",
        "*.config.{ts,mts,js,mjs}",
        "content-collections.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // node --test runs lib modules without the @/ alias, and the e2e specs import tests/local-stack.ts, outside it
      "files": ["src/lib/**", "e2e/**"],
      "rules": {
        "import/no-relative-parent-imports": "off"
      }
    },
    {
      // Command-line scripts print their results
      "files": ["scripts/**", "src/lib/pipeline/print-timeline.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/lib/ui/**"],
      "rules": {
        "react/refs": "off",
        "react/no-children-prop": "off"
      }
    }
  ]
}
