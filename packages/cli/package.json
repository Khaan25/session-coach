{
  "name": "session-coach",
  "version": "0.4.0",
  "type": "module",
  "description": "Upload Claude Code sessions to Session Coach: login, push, sync.",
  "license": "MIT",
  "bin": {
    "session-coach": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts",
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "devDependencies": {
    "@session-coach/shared": "workspace:*",
    "@types/node": "^22",
    "esbuild": "0.28.2",
    "oxlint": "^1.90.0",
    "typescript": "^5"
  }
}
